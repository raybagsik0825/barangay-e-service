# MongoDB connection string (Atlas recommended = cloud storage for documents)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_DB_ADMIN=admin

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# One-time bootstrap: set to true only for the very first deploy, then remove/disable.
# POST /api/auth/bootstrap with { username, password } to create the initial admin.
ENABLE_BOOTSTRAP=true

# One-time account seeding: set a random secret, deploy, then call
# POST /api/auth/seed-accounts with header x-seed-secret=<value>.
# Creates superadmin + 19 barangay staff accounts. Remove after use.
SEED_SECRET=change-me-to-a-long-random-string